# ── Claude access (pick one backend) ─────────────────────────────────
# agent-sdk = your Claude subscription (Pro/Max) via the Claude Code CLI —
#             no API credits needed; usage counts against your plan.
#             Requires the claude CLI installed and logged in
#             (curl -fsSL https://claude.ai/install.sh | bash) and
#             Python 3.10+.
# api       = Anthropic API key + prepaid credits (set ANTHROPIC_API_KEY).
#             Declined requests fall back automatically to the model
#             Anthropic recommends.
LLM_BACKEND=agent-sdk
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high  (low = snappiest voice replies)
LLM_EFFORT=low
LLM_MAX_TOKENS=4096

# nebius    = NVIDIA open models (Nemotron) on Nebius Token Factory.
#             Set LLM_BACKEND=nebius and NEBIUS_API_KEY; LLM_MODEL can stay
#             as is (a claude-* value means "use NEBIUS_MODEL").
#             List the ids your key can use:  python -m jarvis nebius-models --probe
# NEBIUS_API_KEY=
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_FAST_MODEL=nvidia/Nemotron-3_5-Lightning       # quick turns
# NEBIUS_DEEP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b   # "think hard"
# NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL      # "what's on my screen"; empty = off
# NEBIUS_SYSTEM_PREFIX=/no_think
# NEBIUS_PRIVACY=on            # mask emails / phone / card numbers before they leave the Mac

# ── Speech to text ───────────────────────────────────────────────────
# auto   = Whisper large-v3-turbo on the GPU on Apple Silicon (MLX), else local (default)
# mlx    = always the GPU model (MLX_WHISPER_MODEL to change it)
# local  = faster-whisper on the CPU (WHISPER_MODEL)
# openai = OpenAI Whisper API (needs OPENAI_API_KEY)
STT_PROVIDER=auto
WHISPER_MODEL=base.en
# Names and words Jarvis should expect (contacts, artists, places), comma-separated
STT_VOCABULARY=
OPENAI_API_KEY=

# ── Text to speech ───────────────────────────────────────────────────
# piper (local, free, default) | elevenlabs | openai
TTS_PROVIDER=piper
# Path to a downloaded Piper voice model (.onnx). See README for download steps.
PIPER_VOICE=./data/voices/en_GB-alan-medium.onnx
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_TTS_VOICE=alloy

# ── Wake word ────────────────────────────────────────────────────────
# openWakeWord pre-trained model name. "hey_jarvis" ships with the library.
WAKE_WORD_MODEL=hey_jarvis
# 0..1 — raise if it false-triggers, lower if it misses you
WAKE_THRESHOLD=0.5

# ── Timings (seconds) ────────────────────────────────────────────────
# How long Jarvis keeps listening for a follow-up after replying
FOLLOWUP_WINDOW=6
# How long to wait for you to start speaking after the wake word
RECORD_START_TIMEOUT=6
# Pauses are handled by the "patience" setting (snappy / balanced /
# patient), changed in the HUD or by voice; see jarvis/audio/turns.py
# Hard cap on a single utterance
MAX_UTTERANCE_SECONDS=60
# How often the reminder scheduler checks for due reminders
REMINDER_POLL_SECONDS=5
# Mic RMS level (int16) above which audio counts as speech, used only if
# the neural speech detector can't load
RMS_THRESHOLD=500

# ── Google (Gmail + Calendar) ────────────────────────────────────────
# OAuth client file downloaded from Google Cloud Console (Desktop app)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./data/google_token.json

# ── Weather & files ──────────────────────────────────────────────
# City for weather; leave empty to locate this machine by IP
WEATHER_LOCATION=
# Folders Jarvis may search, read and open (comma-separated)
FILES_ROOTS=~/Documents,~/Desktop,~/Downloads,~/Library/Mobile Documents/com~apple~CloudDocs

# ── Semantic recall ──────────────────────────────────────────────
# Local embedding model (downloaded once, ~100 MB). Keep the cache outside
# iCloud: it evicts files.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_CACHE_DIR=~/.cache/jarvis/models
# Cosine score below which a recalled item counts as not relevant
RECALL_MIN_SCORE=0.50
# 0 = don't index conversation turns (memories are still indexed)
RECALL_INDEX_TURNS=1
# Memories are all put in the prompt up to this many characters; beyond it
# only a one-line index is, and Jarvis uses the recall tool for the rest
MEMORY_PRELOAD_CHARS=6000

# ── Paths ────────────────────────────────────────────────────────────
SYSTEM_PROMPT_PATH=./config/jarvis-voice-assistant-system-prompt.md
MEMORY_DIR=./memory
DB_PATH=./data/jarvis.db
